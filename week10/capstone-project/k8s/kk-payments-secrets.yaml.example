# kk-payments-secrets.yaml.example
#
# STRUCTURE DOCUMENTATION ONLY — DO NOT COMMIT REAL VALUES.
#
# The kk-payments Secret is created imperatively per namespace and is
# intentionally NOT committed to git. Recreate it after any cluster rebuild
# with (repeat for both namespaces):
#
#   kubectl create secret generic kk-payments-secrets \
#     --from-literal=DB_PASSWORD=<obtain-from-team> \
#     --from-literal=STRIPE_API_KEY=<obtain-from-team> \
#     --from-literal=JWT_SECRET=<obtain-from-team> \
#     -n kijani-project
#
#   kubectl create secret generic kk-payments-secrets \
#     --from-literal=DB_PASSWORD=<staging-value> \
#     --from-literal=STRIPE_API_KEY=<staging-value> \
#     --from-literal=JWT_SECRET=<staging-value> \
#     -n kijani-staging
#
# This file exists so that anyone cloning the repo knows the Secret name and
# the exact keys the kk-payments Deployment expects via envFrom. The real
# values must be obtained from the team before applying — never place them here.
apiVersion: v1
kind: Secret
metadata:
  name: kk-payments-secrets
  namespace: kijani-project
type: Opaque
stringData:
  DB_PASSWORD: "<obtain-from-team>"
  STRIPE_API_KEY: "<obtain-from-team>"
  JWT_SECRET: "<obtain-from-team>"
