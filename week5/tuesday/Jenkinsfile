pipeline {
    agent any

    environment {
        NODE_ENV  = 'test'
        BUILD_DIR = 'dist'
        APP_NAME  = 'kijanikiosk-payments'
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    stages {
        stage('Build') {
            steps {
                sh 'npm ci'
                sh 'npm run build'
                sh '''
                    if [ ! -d "$BUILD_DIR" ]; then
                        echo "Build output directory $BUILD_DIR not found"
                        exit 1
                    fi
                    echo "Build output file count: $(ls "$BUILD_DIR" | wc -l)"
                '''
            }
        }
        stage('Test') {
            steps {
                sh '''
                    set -e
                    npm test
                '''
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/junit.xml'
                }
            }
        }
        stage('Archive') {
            steps {
                archiveArtifacts artifacts: "${BUILD_DIR}/**", fingerprint: true
            }
        }
    }

    post {
        success {
            echo "Build #${env.BUILD_NUMBER} succeeded. Artifacts: ${env.BUILD_URL}artifact/"
        }
        failure {
            echo "Build #${env.BUILD_NUMBER} failed. Check the stage logs above for the first red stage."
        }
        always {
            cleanWs()
        }
    }
}
